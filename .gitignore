# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/
.pnp.*

# Vite / TypeScript build output and caches
/dist/
/dist-ssr/
.vite/
.cache/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs, diagnostic reports and crash dumps
logs/
*.log
pids/
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
/core
/core.[0-9]*

# Test output (keep deliberate screenshots and checks under docs/)
coverage/
.nyc_output/
*.lcov
/playwright-report/
/test-results/
/blob-report/

# Local secrets; sample configuration can be committed
.env
.env.*
!.env.example
!.env.*.example

# Local tooling and Nix state (tools/ contains tracked build utilities)
/.tools/
/.direnv/
/result
/result-*
/.rundot-docs/
/.claude/settings.local.json

# Editor and operating-system metadata
.vscode/
.idea/
.vscode-test/
.DS_Store
Thumbs.db
*Zone.Identifier
*.swp
*.swo
*~

# Redundant asset downloads and upstream web shortcuts.
# Keep unpacked source art, licenses, runtime art, atlas metadata/build scripts,
# and the deliberate pre-pivot archive so a checkout retains the project inputs.
/src/assets/source/**/*.zip
/src/assets/source/**/*.7z
/src/assets/source/**/*.rar
/src/assets/source/**/*.url
/assets/source/**/*.zip
/assets/source/**/*.7z
/assets/source/**/*.rar
/assets/source/**/*.url
